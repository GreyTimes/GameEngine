{
  "gameTitle": "The Last Sigil",
  "currency": { "name": "Gold" },
  "startRoom": "forest_entrance",

  "commands": {
    "enabled": ["go","exit","help","look","take","drop","inventory","playerstate","use","equip","hit","throw","flee","interact","unequip"],
    "aliases": {
      "go": ["go","move","walk"],
      "exit": ["exit","quit","q"],
      "help": ["help","h","?"],
      "look": ["look","see","inspect"],
      "take": ["take","get","pickup"],
      "drop": ["drop","discard"],
      "inventory": ["inventory","inv","i"],
      "playerstate": ["playerstate","stats","s"],
      "use": ["use"],
      "equip": ["equip","wear","wield"],
      "hit": ["hit","attack"],
      "throw": ["throw"],
      "flee": ["flee","run"],
      "interact": ["interact","talk","speak"],
      "unequip": ["unequip"]
    }
  },

  "helpLines": [
    "~Commands & Syntax~",
    "go <direction>   -> Move to another room if an exit exists. Example: go north",
    "look             -> Show items visible in the current room.",
    "take <item name> -> Pick up an item by NAME from the room. Example: take rusty key",
    "take all         -> Pick up all items from the room.",
    "drop <item name> -> Drop an item by Name to the room. Example: drop rusty key.",
    "drop all         -> Drop all items to the room.",
    "equip <item name>-> Equip a piece of equipment. Example: equip iron sword.",
    "unequip weapon | unequip armor",
    "                 -> Unequip a piece of equipment.",
    "inventory        -> Show items currently in your inventory.",
    "use <itemId> <targetId> | use <item name> on <target name>",
    "                 -> Use an item on a target using IDs. Example: use rusty_key entrance_east_door",
    "flee             -> Only available at fight/flee prompt; returns you to previous room.",
    "hit              -> Attack during combat (player attacks first, then monster).",
    "throw <itemId>   -> Use a consumable item to inflict damage to a monster.",
    "playerstate      -> Show your current HP.",
    "interact         -> Talk to NPCs / trade with a trader.",
    "help             -> Show this help text.",
    "exit             -> Close the game.",
    "~Commands' synonyms~",
    "go <direction>   -> move, walk. Example: Move east.",
    "look             -> see, inspect.",
    "take             -> get, pickup.",
    "drop             -> discard.",
    "inventory        -> inv, i.",
    "playerstate      -> stats, s.",
    "interact         -> talk, speak.",
    "help             -> h, ?.",
    "exit             -> quit, q."
  ],

