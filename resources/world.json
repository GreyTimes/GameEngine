  "npcs": [
    {
      "id": "forest_old_man",
      "name": "Old Woodsman",
      "type": "dialogue",
      "room": "wood_hut",
      "lines": [
        "Hear my advice stranger.",
        "In the forest a useful rock is hidden. It glows like a star.",
        "Use it to go through the portal."
      ],
      "dialogue": [
        { "option": "Where can I find this rock?", "response": "Search the big tree. It’s hidden somewhere inside." },
        { "option": "What portal?", "response": "There’s a portal hidden in the big tree. It leads to a road across the fields." }
      ]
    },
