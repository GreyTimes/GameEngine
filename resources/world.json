      "id": "field_priest",
      "name": "Village Priest",
      "type": "dialogue",
      "room": "small_shrine",
      "lines": [
        "The sigil was taken from this land.",
        "Find it and use it to open the gate."
      ],
      "dialogue": [
        { "option": "What sigil?", "response": "The sigil is a sacred seal that was stolen from the shrine. It’s needed to open the castle gate." },
        { "option": "Where can I find it?", "response": "I heard it’s hidden in the burned barn east of here." }
      ]
    },
