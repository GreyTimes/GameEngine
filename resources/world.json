    }
  ],

  "useRules": [
    {
      "item": "shiny_rock",
      "target": "big_tree_portal",
      "conditions": [
        { "type": "inRoom", "room": "big_tree" },
        { "type": "hasItem", "item": "shiny_rock" }
      ],
      "effects": [
        { "type": "message", "text": "The rock crumbles and a portal appears in front of you." },
        { "type": "addExit", "room": "big_tree", "direction": "east", "to": "open_road" },
        { "type": "consumeItem", "item": "shiny_rock"}
      ]
    },
    {
      "item": "last_sigil",
      "target": "castle_gate_lock",
      "conditions": [
        { "type": "inRoom", "room": "castle_gate" },
        { "type": "hasItem", "item": "last_sigil" }
      ],
      "effects": [
        { "type": "message", "text": "The sigil glows and the gate opens." },
        { "type": "addExit", "room": "castle_gate", "direction": "east", "to": "castle_yard" },
        { "type": "consumeItem", "item": "last_sigil" }
      ]
    },
    {
      "item": "healing_potion",
      "target": "self",
      "conditions": [
        { "type": "hasItem", "item": "healing_potion" }
      ],
      "effects": [
        { "type": "message", "text": "You drink the potion." },
        { "type": "heal", "amount": 20, "cap": 100 },
        { "type": "consumeItem", "item": "healing_potion", "skipIfNoEffect": true }
      ]
    }
